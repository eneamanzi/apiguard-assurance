# APIGuard Assurance - environment variables template
#
# Create your local copy once, from the repository root:
#     cp .env.example .env
# .env is ignored by git: NEVER commit it.
#
# The values below are fictitious credentials for the local test lab
# (test-environments/forgejo-kong). They work as they are for the lab.
# To assess a real target, replace them in .env with real values.
#
# Who reads what:
#   - the tool reads the variables referenced as ${VAR} in the configuration file in use
#     (config.yaml uses the Forgejo section, config_crapi.yaml the cRAPI section);
#   - the lab (docker compose --env-file ../../.env) reads the Forgejo section and the lab section.
# Variables nobody references are ignored.

# --- Forgejo target: accounts used by the tool and created by the lab ---
ADMIN_USERNAME=thesis-admin
ADMIN_PASSWORD=ChangeMe-Admin-Password
USER_A_USERNAME=user-a
USER_A_PASSWORD=ChangeMe-UserA-Password
USER_B_USERNAME=user-b
USER_B_PASSWORD=ChangeMe-UserB-Password

# --- Lab only: database password, Forgejo secret key, test repository created for user A ---
LAB_DB_PASSWORD=ChangeMe-Lab-DB-Password
LAB_FORGEJO_SECRET_KEY=ChangeMe-Lab-Secret-Key
LAB_TEST_REPO=test-repo

# --- cRAPI target (config_crapi.yaml), not part of the lab ---
# The accounts must exist on your cRAPI instance.
CRAPI_ADMIN_EMAIL=
CRAPI_ADMIN_PASSWORD=
CRAPI_USER_A_EMAIL=
CRAPI_USER_A_PASSWORD=
CRAPI_USER_B_EMAIL=
CRAPI_USER_B_PASSWORD=
