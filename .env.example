# APIGuard Assurance - environment variables template
#
# Create your local copy once, from the repository root:
#     cp .env.example .env
# .env is ignored by git: NEVER commit it.
#
# The values below are fictitious credentials for the local test labs
# (test-environments/). They work as they are for the labs.
# To assess a real target, replace them in .env with real values.
#
# Who reads what:
#   - the tool reads the variables referenced as ${VAR} in the configuration file in use
#     (test-environments/forgejo-kong/config.yaml uses the Forgejo section,
#     test-environments/crapi-kong/config.yaml the cRAPI section);
#   - each lab (docker compose --env-file ../../.env) reads its own sections: both Forgejo labs
#     (forgejo-kong, forgejo-apisix) the Forgejo section and the lab section, forgejo-apisix also
#     the APISIX section; crapi-kong the cRAPI section.
# Variables nobody references are ignored.

# --- Forgejo target: accounts used by the tool and created by the lab ---
ADMIN_USERNAME=thesis-admin
ADMIN_PASSWORD=ChangeMe-Admin-Password
USER_A_USERNAME=user-a
USER_A_PASSWORD=ChangeMe-UserA-Password
# user B: not used by v0.1.0 tests; reserved for tests that compare two users (e.g. BOLA, guarantee 2.2).
USER_B_USERNAME=user-b
USER_B_PASSWORD=ChangeMe-UserB-Password

# --- Lab only: database password, Forgejo secret key, test resources created for user A ---
# The names are also read by the Forgejo lab configuration (target.path_seed).
LAB_DB_PASSWORD=ChangeMe-Lab-DB-Password
LAB_FORGEJO_SECRET_KEY=ChangeMe-Lab-Secret-Key
LAB_TEST_REPO=test-repo
LAB_TEST_ORG=test-org
LAB_TEST_TAG=v0.1.0

# --- cRAPI lab (test-environments/crapi-kong, also its config.yaml) ---
# The admin is one of the accounts crAPI creates at startup: it cannot be created through the
# API, and its password is public in crAPI's source (TestUsers.java). The lab setup creates
# user A and user B through crAPI's signup endpoint.
CRAPI_ADMIN_EMAIL=admin@example.com
CRAPI_ADMIN_PASSWORD=Admin!123
CRAPI_USER_A_EMAIL=apiguard-user-a@example.com
CRAPI_USER_A_PASSWORD=ChangeMe-UserA-Password
CRAPI_USER_B_EMAIL=apiguard-user-b@example.com
CRAPI_USER_B_PASSWORD=ChangeMe-UserB-Password
LAB_CRAPI_DB_PASSWORD=ChangeMe-Lab-cRAPI-DB-Password

# --- Forgejo + APISIX lab (test-environments/forgejo-apisix) ---
# Keys of the APISIX Admin API. The admin key is used only by the lab setup to write the gateway
# configuration; the viewer key (GET only) is the one the tool sends (target.admin_api_headers).
APISIX_ADMIN_KEY=ChangeMe-Lab-APISIX-Admin-Key
APISIX_VIEWER_KEY=ChangeMe-Lab-APISIX-Viewer-Key
