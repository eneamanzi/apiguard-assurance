# =============================================================================
# PROJECT-SPECIFIC — entries specific to APIGuard Assurance
# =============================================================================

# External tools binaries (nuclei, testssl, sslyze) — installed locally, not committed
/tools/*

# Assessment outputs — generated at runtime by `apiguard run`, never committed.
# outputs/ is the canonical location; individual filenames are legacy fallbacks.
outputs/
evidence.json
assessment_report.html
test_report.html

# OpenAPI specs downloaded at runtime
specs/

# Local config overrides and secrets
config.local.yaml
.env
.env.*
!.env.example

# Claude Code local IDE settings (hooks, session cache) — machine-specific
.claude/

# Project archive
apiguard-assurance.zip

# Docker local overrides with secrets
docker-compose.override.yml
docker-compose.local.yml

# Static analysis caches (tools configured in pyproject.toml)
.mypy_cache/
.dmypy.json
dmypy.json
.ruff_cache/

# =============================================================================
# PYTHON — standard Python project artifacts
# =============================================================================

# Bytecode
__pycache__/
*.py[cod]
*$py.class
*.pyc

# Virtual environments
.venv/
venv/
env/
ENV/

# Build and distribution
dist/
build/
*.egg-info/
*.egg
MANIFEST

# Test and coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
nosetests.xml

# Logs
*.log

# =============================================================================
# IDE AND EDITOR — generic editor artifacts
# =============================================================================

.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
*.swp
*.swo
*~
.DS_Store
Thumbs.db
